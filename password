import tkinter as tk
from tkinter import simpledialog
import subprocess

PASSWORD = "K45HH80B0V-3B6O1"

unlocked = False

def check_password():
    global unlocked

    pwd = simpledialog.askstring("PASSWORD!!!!!?!?!?!", "password?:", show="*")

    if pwd == PASSWORD:
        unlocked = True
        status.config(text="yay!!", fg="green")
        log.insert(tk.END, "there you go")
    else:
        status.config(text="nope", fg="red")
        log.insert(tk.END, "wrong one")

def launch_roblox():
    if not unlocked:
        log.insert(tk.END, "blocked, youre stupid")
        return

    log.insert(tk.END, "launching...")
    subprocess.Popen("start app:", shell=True)

root = tk.Tk()
root.title("secure Launcher")
root.geometry("326x220")

status = tk.Label(root, text="LOCKED", fg="red", font=("Arial", 16))
status.pack(pady=10)

btn_login = tk.Button(root, text="password", command=check_password)
btn_login.pack(pady=4)

btn_launch = tk.Button(root, text="launch it", command=launch_roblox)
btn_launch.pack(pady=5)

log = tk.Listbox(root, width=40, height=8)
log.pack(pady=10)

root.mainloop()
